{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "verbatimModuleSyntax": false,
    "erasableSyntaxOnly": false
  },
  "include": ["functions"]
}