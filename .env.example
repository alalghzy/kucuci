# ============================================================
# KuCuci — contoh konfigurasi environment
# Salin jadi .env (frontend build) dan/atau .dev.vars (dev lokal)
# Nilai asli JANGAN pernah di-commit ke git.
# ============================================================

# ---------- Frontend (Vite — prefix VITE_) ----------
VITE_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
VITE_API_BASE=/api
# Nomor WhatsApp admin (internasional tanpa +), contoh 6281234567890
VITE_WA_NUMBER=6281234567890

# ---------- Backend (Cloudflare Pages Functions) ----------
# Saat dev lokal: taruh di file .dev.vars
# Saat production: set via `wrangler pages secret put NAMA` atau Dashboard Pages

# Secret JWT utk sesi login (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=ganti-dengan-random-hex-64

# Google OAuth (Console Cloud Google → Credentials → OAuth Client ID Web)
# Redirect URI: https://<domain-anda>/api/auth/google/callback
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=ganti

# Akun admin (login admin via /kucuci_admin)
ADMIN_EMAIL=admin@example.com
# Generate hash: node -e "console.log(require('bcryptjs').hashSync('password-anda', 10))"
ADMIN_PASSWORD_HASH=$2a$10$ganti-dengan-hash-bcrypt

# ---------- Midtrans QRIS (opsional — tanpa ini pembayaran QRIS nonaktif) ----------
# Sandbox: https://dashboard.sandbox.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
# true untuk production, kosong/false untuk sandbox
MIDTRANS_IS_PRODUCTION=false
